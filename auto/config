#!/bin/sh
# NEXORA OS Minimal — Debian 13 Trixie, terminal-only live system.
set -eu

lb config noauto \
    --mode debian \
    --distribution trixie \
    --architecture amd64 \
    --binary-image iso-hybrid \
    --archive-areas "main" \
    --apt-recommends false \
    --apt-secure true \
    --security false \
    --debian-installer none \
    --firmware-binary false \
    --firmware-chroot false \
    --iso-application "NEXORA OS Minimal" \
    --iso-publisher "NEXORA OS Project" \
    --iso-volume "NEXORA_MINIMAL_0_1_0" \
    --linux-packages none \
    --initsystem systemd \
    --memtest none \
    --bootappend-live "boot=live components locales=es_CL.UTF-8 keyboard-layouts=latam" \
    "${@}"
