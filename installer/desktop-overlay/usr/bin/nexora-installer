#!/usr/bin/python3
"""NEXORA OS's native GTK3 installation wizard."""
import json
import os
import re
import subprocess
import tempfile
from pathlib import Path

import gi
gi.require_version("Gtk", "3.0")
from gi.repository import Gtk, Gdk, GLib

ENGINE = "/usr/lib/nexora-installer/install-engine.py"
BRAND = "/usr/share/nexora/branding"
TITLE = "Instalador NEXORA OS"

CSS = b"""
window { background: #101827; color: #eaf4ff; }
headerbar { background: #0b1220; color: #f3f8ff; border-bottom: 1px solid #23354d; }
.title-label { color: #f3f8ff; font-weight: bold; }
.hero { background: #0b1220; border-radius: 16px; padding: 24px; }
.hero-title { color: #f3f8ff; font-size: 28px; font-weight: 700; }
.hero-subtitle { color: #79d9f2; font-size: 14px; }
.card { background: #172337; border: 1px solid #2b405b; border-radius: 12px; padding: 18px; }
button { padding: 9px 16px; border-radius: 8px; }
button.suggested-action { background: #16a6c8; color: #06131d; font-weight: bold; }
label { color: #eaf4ff; }
entry, combobox, spinbutton { background: #0c1524; color: #eaf4ff; border: 1px solid #344963; padding: 8px; }
progressbar trough { background: #25364c; border-radius: 8px; min-height: 10px; }
progressbar progress { background: #20b6d8; border-radius: 8px; }
"""
def detect_install_profile(release_file="/etc/nexora-release"):
    """Detect which NEXORA edition booted; never ask users to choose it."""
    try:
        release = Path(release_file).read_text(encoding="utf-8")
    except OSError:
        return None
    if "NEXORA OS XFCE4 Live" in release:
        return "xfce"
    if "NEXORA OS Minimal GTK Installer" in release:
        return "minimal"
    return None


def label(text, size=None, bold=False):
    widget = Gtk.Label(label=text)
    widget.set_xalign(0)
    widget.set_line_wrap(True)
    if size:
        widget.set_markup(f'<span size="{size}" weight="bold" foreground="#f3f8ff">{GLib.markup_escape_text(text)}</span>')
    elif bold:
        widget.set_markup(f"<b>{GLib.markup_escape_text(text)}</b>")
    return widget

def get_disks():
    try:
        raw = subprocess.check_output(
            ["lsblk", "-J", "-b", "-o", "NAME,SIZE,MODEL,TYPE,RM,MOUNTPOINTS"],
            text=True, stderr=subprocess.DEVNULL
        )
        data = json.loads(raw)
    except Exception:
        return []
    result = []
    def mounted(node):
        if any(point for point in (node.get("mountpoints") or []) if point):
            return True
        return any(mounted(child) for child in (node.get("children") or []))
    for item in data.get("blockdevices", []):
        if item.get("type") != "disk" or not item.get("name"):
            continue
        # Never offer a disk that is currently mounted by the Live session.
        if mounted(item):
            continue
        size = int(item.get("size") or 0)
        if size < 12 * 1024**3:
            continue
        model = (item.get("model") or "Disco").strip()
        result.append((f"/dev/{item['name']}", f"{model} — {size / 1024**3:.1f} GB (/dev/{item['name']})"))
    return result

def get_storage_inventory():
    """Return a read-only disk/partition inventory for the GTK storage screen."""
    try:
        raw = subprocess.check_output(
            ["lsblk", "-J", "-b", "-o", "NAME,SIZE,MODEL,TYPE,RM,FSTYPE,MOUNTPOINTS"],
            text=True, stderr=subprocess.DEVNULL
        )
        devices = json.loads(raw).get("blockdevices", [])
    except (OSError, subprocess.SubprocessError, ValueError):
        return []
    rows = []
    def walk(node, depth=0, parent_eligible=False):
        kind = node.get("type") or "unknown"
        name = node.get("name") or ""
        path = f"/dev/{name}" if name else ""
        mounts = [point for point in (node.get("mountpoints") or []) if point]
        mounted = bool(mounts)
        size = int(node.get("size") or 0)
        eligible = (depth == 0 and kind == "disk" and size >= 12 * 1024**3
                    and not mounted and not parent_eligible)
        model = (node.get("model") or "Disco").strip()
        label_text = f"{model} — {size / 1024**3:.1f} GB" if depth == 0 else f"{name}"
        if mounted:
            label_text += " · En uso"
        detail = node.get("fstype") or kind
        if mounts:
            detail += " · " + ", ".join(mounts)
        rows.append((label_text, path, detail, eligible, depth))
        for child in node.get("children") or []:
            walk(child, depth + 1, mounted or parent_eligible)
    for device in devices:
        walk(device)
    return rows

class NexoraInstaller(Gtk.Window):
    def __init__(self):
        super().__init__(title=TITLE)
        self.set_default_size(920, 680)
        self.set_size_request(700, 520)
        self.set_position(Gtk.WindowPosition.CENTER)
        # Permitir ajustar el tamaño según la resolución y las preferencias del usuario.
        self.set_resizable(True)
        self.process = None
        self.secret_path = None
        self.page = 0
        self.install_started = False
        self.desktop_profile = detect_install_profile()
        icon = os.path.join(BRAND, "nexora-icon.svg")
        if os.path.exists(icon):
            try: self.set_icon_from_file(icon)
            except Exception: pass

        provider = Gtk.CssProvider()
        provider.load_from_data(CSS)
        Gtk.StyleContext.add_provider_for_screen(
            Gdk.Screen.get_default(), provider, Gtk.STYLE_PROVIDER_PRIORITY_APPLICATION
        )

        outer = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=0)
        self.add(outer)
        header = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=12)
        header.set_border_width(18)
        header.set_name("header")
        logo = Gtk.Image.new_from_file(os.path.join(BRAND, "nexora-icon.svg")) if os.path.exists(os.path.join(BRAND, "nexora-icon.svg")) else Gtk.Image()
        logo.set_pixel_size(36)
        header.pack_start(logo, False, False, 0)
        header.pack_start(label("NEXORA OS  ·  INSTALADOR", "large"), True, True, 0)
        outer.pack_start(header, False, False, 0)

        self.stack = Gtk.Stack()
        self.stack.set_transition_type(Gtk.StackTransitionType.SLIDE_LEFT_RIGHT)
        self.stack.set_transition_duration(180)
        outer.pack_start(self.stack, True, True, 0)
        self.build_welcome()
        self.build_storage()
        self.build_config()
        self.build_review()
        self.build_progress()

        footer = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=10)
        footer.set_border_width(18)
        self.status = Gtk.Label(label="Instalación guiada de NEXORA")
        self.status.set_xalign(0)
        footer.pack_start(self.status, True, True, 0)
        self.back = Gtk.Button(label="Atrás")
        self.back.connect("clicked", self.go_back)
        footer.pack_start(self.back, False, False, 0)
        self.next = Gtk.Button(label="Continuar")
        self.next.get_style_context().add_class("suggested-action")
        self.next.connect("clicked", self.go_next)
        footer.pack_start(self.next, False, False, 0)
        outer.pack_start(footer, False, False, 0)
        self.connect("delete-event", self.on_close)
        self.show_page(0)

    def card(self, child):
        box = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=12)
        box.get_style_context().add_class("card")
        box.pack_start(child, True, True, 0)
        return box

    def build_welcome(self):
        page = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=20)
        page.set_border_width(28)
        hero = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=10)
        hero.get_style_context().add_class("hero")
        hero.pack_start(label("Bienvenido a NEXORA OS", "xx-large"), False, False, 0)
        hero.pack_start(label("Tu escritorio. Tu universo.", "large"), False, False, 0)
        hero.pack_start(label("Instala el sistema NEXORA en tu equipo con un asistente gráfico propio."), False, False, 0)
        page.pack_start(hero, False, False, 0)
        info = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=12)
        info.get_style_context().add_class("card")
        info.pack_start(label("Antes de comenzar", bold=True), False, False, 0)
        info.pack_start(label("• Necesitarás un disco de al menos 12 GB.\n• La instalación requiere conexión a la red para actualizaciones posteriores.\n• El modo automático borrará completamente el disco seleccionado."), False, False, 0)
        warning = label("IMPORTANTE: no selecciones un disco que contenga archivos que quieras conservar.", bold=True)
        info.pack_start(warning, False, False, 0)
        page.pack_start(info, True, True, 0)
        self.stack.add_named(page, "welcome")

    def build_storage(self):
        page = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=14)
        page.set_border_width(24)
        page.pack_start(label("Almacenamiento", "x-large"), False, False, 0)
        page.pack_start(label("Revisa los discos y sus particiones. Seleccionar un disco para instalación automática borrará todo su contenido."), False, False, 0)

        self.storage_model = Gtk.TreeStore(str, str, str, bool)
        self.storage_view = Gtk.TreeView(model=self.storage_model)
        self.storage_view.set_headers_visible(True)
        for title, column_id in (("Dispositivo", 0), ("Ruta", 1), ("Tipo / montaje", 2)):
            renderer = Gtk.CellRendererText()
            column = Gtk.TreeViewColumn(title, renderer, text=column_id)
            column.set_resizable(True)
            self.storage_view.append_column(column)
        self.storage_view.get_selection().connect("changed", self.on_storage_selection)
        scroller = Gtk.ScrolledWindow()
        scroller.set_min_content_height(230)
        scroller.set_policy(Gtk.PolicyType.AUTOMATIC, Gtk.PolicyType.AUTOMATIC)
        scroller.add(self.storage_view)
        page.pack_start(scroller, True, True, 0)

        note = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=6)
        note.get_style_context().add_class("card")
        note.pack_start(label("Modo actual: disco completo (automático)", bold=True), False, False, 0)
        note.pack_start(label("La selección de particiones individuales todavía no está habilitada. Esta pantalla es de inspección: no modifica discos."), False, False, 0)
        page.pack_start(note, False, False, 0)
        refresh = Gtk.Button(label="Actualizar dispositivos")
        refresh.connect("clicked", lambda _button: self.refresh_storage())
        page.pack_start(refresh, False, False, 0)
        self.stack.add_named(page, "storage")
        self.refresh_storage()

    def refresh_storage(self):
        self.storage_model.clear()
        self.disks = get_disks()
        for title, path, detail, eligible, depth in get_storage_inventory():
            parent = None
            if depth:
                # Attach each partition to the most recently inserted top-level disk.
                parent = getattr(self, "_storage_parent", None)
            if depth == 0:
                parent = self.storage_model.append(None, [title, path, detail, eligible])
                self._storage_parent = parent
            else:
                self.storage_model.append(parent, [title, path, detail, eligible])
        if hasattr(self, "disk_combo"):
            self.disk_combo.remove_all()
            for device, description in self.disks:
                self.disk_combo.append(device, description)
            if self.disks:
                self.disk_combo.set_active(0)
        self.selected_storage_disk = None

    def on_storage_selection(self, selection):
        model, iterator = selection.get_selected()
        if iterator is None:
            self.selected_storage_disk = None
            return
        device = model.get_value(iterator, 1)
        eligible = model.get_value(iterator, 3)
        # Only selectable top-level disks may be used in whole-disk mode.
        parent = model.iter_parent(iterator)
        if parent is None and eligible:
            self.selected_storage_disk = device
            if hasattr(self, "disk_combo"):
                self.disk_combo.set_active_id(device)
        else:
            self.selected_storage_disk = None

    def build_config(self):
        page = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=16)
        page.set_border_width(24)
        page.pack_start(label("Preparar la instalación", "x-large"), False, False, 0)
        page.pack_start(label("Selecciona el disco de destino y crea tu cuenta de usuario."), False, False, 0)

        form = Gtk.Grid(column_spacing=16, row_spacing=14)
        form.get_style_context().add_class("card")
        form.set_border_width(18)
        form.attach(label("Disco de destino", bold=True), 0, 0, 1, 1)
        self.disk_combo = Gtk.ComboBoxText()
        self.disks = get_disks()
        for device, description in self.disks:
            self.disk_combo.append(device, description)
        if self.disks: self.disk_combo.set_active(0)
        form.attach(self.disk_combo, 1, 0, 1, 1)
        form.attach(label("Nombre del equipo", bold=True), 0, 1, 1, 1)
        self.host = Gtk.Entry()
        self.host.set_text("nexora-pc")
        form.attach(self.host, 1, 1, 1, 1)
        form.attach(label("Nombre de usuario", bold=True), 0, 2, 1, 1)
        self.user = Gtk.Entry()
        self.user.set_text("nexora")
        form.attach(self.user, 1, 2, 1, 1)
        form.attach(label("Contraseña", bold=True), 0, 3, 1, 1)
        self.password = Gtk.Entry()
        self.password.set_visibility(False)
        self.password.set_input_purpose(Gtk.InputPurpose.PASSWORD)
        form.attach(self.password, 1, 3, 1, 1)
        form.attach(label("Confirmar contraseña", bold=True), 0, 4, 1, 1)
        self.password2 = Gtk.Entry()
        self.password2.set_visibility(False)
        self.password2.set_input_purpose(Gtk.InputPurpose.PASSWORD)
        form.attach(self.password2, 1, 4, 1, 1)

        form.attach(label("Cuenta de superusuario (root)", bold=True), 0, 5, 1, 1)
        self.root_enabled = Gtk.CheckButton(label="Activar cuenta root con contraseña propia")
        self.root_enabled.connect("toggled", self.on_root_toggle)
        form.attach(self.root_enabled, 1, 5, 1, 1)
        form.attach(label("Contraseña de root", bold=True), 0, 6, 1, 1)
        self.root_password = Gtk.Entry()
        self.root_password.set_visibility(False)
        self.root_password.set_input_purpose(Gtk.InputPurpose.PASSWORD)
        self.root_password.set_sensitive(False)
        form.attach(self.root_password, 1, 6, 1, 1)
        form.attach(label("Confirmar contraseña root", bold=True), 0, 7, 1, 1)
        self.root_password2 = Gtk.Entry()
        self.root_password2.set_visibility(False)
        self.root_password2.set_input_purpose(Gtk.InputPurpose.PASSWORD)
        self.root_password2.set_sensitive(False)
        form.attach(self.root_password2, 1, 7, 1, 1)

        form.attach(label("Idioma del sistema", bold=True), 0, 8, 1, 1)
        self.locale_combo = Gtk.ComboBoxText()
        for code, title in (("es_CL.UTF-8", "Español (Chile)"),
                            ("es_ES.UTF-8", "Español (España)"),
                            ("en_US.UTF-8", "English (United States)"),
                            ("en_GB.UTF-8", "English (United Kingdom)"),
                            ("pt_BR.UTF-8", "Português (Brasil)")):
            self.locale_combo.append(code, title)
        self.locale_combo.set_active_id("es_CL.UTF-8")
        form.attach(self.locale_combo, 1, 8, 1, 1)

        form.attach(label("Distribución del teclado", bold=True), 0, 9, 1, 1)
        self.keyboard_combo = Gtk.ComboBoxText()
        for code, title in (("latam", "Latinoamericano"), ("us", "English (US)"),
                            ("es", "Español"), ("br", "Português (Brasil)")):
            self.keyboard_combo.append(code, title)
        self.keyboard_combo.set_active_id("latam")
        form.attach(self.keyboard_combo, 1, 9, 1, 1)

        form.attach(label("Zona horaria", bold=True), 0, 10, 1, 1)
        self.timezone_combo = Gtk.ComboBoxText()
        for zone, title in (("America/Santiago", "Chile continental (Santiago)"),
                            ("America/Punta_Arenas", "Chile austral (Punta Arenas)"),
                            ("America/Easter", "Isla de Pascua"),
                            ("America/Argentina/Buenos_Aires", "Argentina"),
                            ("America/Lima", "Perú"), ("America/Bogota", "Colombia"),
                            ("America/Mexico_City", "México"), ("Europe/Madrid", "España"),
                            ("UTC", "UTC")):
            self.timezone_combo.append(zone, title)
        self.timezone_combo.set_active_id("America/Santiago")
        form.attach(self.timezone_combo, 1, 10, 1, 1)
        form.attach(label("Edición detectada automáticamente", bold=True), 0, 11, 1, 1)
        detected_name = {
            "xfce": "NEXORA XFCE4",
            "minimal": "NEXORA Minimal",
        }.get(self.desktop_profile, "Edición no reconocida")
        form.attach(label(detected_name), 1, 11, 1, 1)

        form.attach(label("Servidor APT", bold=True), 0, 12, 1, 1)
        self.apt_mirror = Gtk.Entry()
        self.apt_mirror.set_text("https://deb.debian.org/debian")
        self.apt_mirror.set_placeholder_text("https://deb.debian.org/debian")
        form.attach(self.apt_mirror, 1, 12, 1, 1)

        form.attach(label("Conectividad", bold=True), 0, 13, 1, 1)
        network_box = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=6)
        self.network_status = Gtk.Label(label="Comprobando conexión de NetworkManager…")
        self.network_status.set_xalign(0)
        network_box.pack_start(self.network_status, False, False, 0)
        network_refresh = Gtk.Button(label="Comprobar conexión")
        network_refresh.connect("clicked", lambda _button: self.refresh_network_status())
        network_box.pack_start(network_refresh, False, False, 0)
        network_setup = Gtk.Button(label="Configurar Wi-Fi o conexión")
        network_setup.connect("clicked", self.open_network_editor)
        network_box.pack_start(network_setup, False, False, 0)
        form.attach(network_box, 1, 13, 1, 1)
        GLib.idle_add(self.refresh_network_status)

        config_scroll = Gtk.ScrolledWindow()
        config_scroll.set_policy(Gtk.PolicyType.AUTOMATIC, Gtk.PolicyType.AUTOMATIC)
        config_scroll.set_min_content_height(360)
        config_scroll.add(form)
        page.pack_start(config_scroll, True, True, 0)
        self.stack.add_named(page, "config")
        if self.disks:
            self.selected_storage_disk = self.disks[0][0]

    def on_root_toggle(self, button):
        enabled = button.get_active()
        self.root_password.set_sensitive(enabled)
        self.root_password2.set_sensitive(enabled)
        if not enabled:
            self.root_password.set_text("")
            self.root_password2.set_text("")

    def open_network_editor(self, _button):
        try:
            subprocess.Popen(["nm-connection-editor"])
        except OSError:
            self.show_error(
                "No se encontró el editor gráfico de NetworkManager. "
                "Conecta la red desde el menú de red del escritorio Live."
            )

    def refresh_network_status(self):
        try:
            result = subprocess.run(
                ["nmcli", "-t", "-f", "STATE", "general"],
                text=True, stdout=subprocess.PIPE, stderr=subprocess.DEVNULL, timeout=5
            )
            state = result.stdout.strip()
            if state == "connected":
                detail = subprocess.run(
                    ["nmcli", "-t", "-f", "NAME,TYPE", "connection", "show", "--active"],
                    text=True, stdout=subprocess.PIPE, stderr=subprocess.DEVNULL, timeout=5
                ).stdout.strip().replace("\\n", ", ")
                self.network_status.set_text("Conectado · " + (detail or "NetworkManager"))
            else:
                self.network_status.set_text("Sin conexión activa · conecta Ethernet o Wi-Fi antes de instalar")
        except (OSError, subprocess.SubprocessError):
            self.network_status.set_text("No se pudo consultar NetworkManager")
        return False

    def build_review(self):
        """Pantalla de revisión: no muestra contraseñas ni datos secretos."""
        page = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=16)
        page.set_border_width(24)
        page.pack_start(label("Revisión final", "x-large"), False, False, 0)
        page.pack_start(label(
            "Comprueba todos los ajustes. La instalación automática eliminará "
            "por completo el disco seleccionado.", bold=True
        ), False, False, 0)
        card = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=10)
        card.get_style_context().add_class("card")
        self.review_labels = {}
        for key, title in (
            ("disk", "Disco de destino"),
            ("hostname", "Nombre del equipo"),
            ("username", "Usuario principal"),
            ("root", "Cuenta root"),
            ("locale", "Idioma"),
            ("keyboard", "Teclado"),
            ("timezone", "Zona horaria"),
            ("desktop", "Entorno de escritorio"),
            ("network", "Red"),
            ("apt", "Repositorio APT"),
        ):
            line = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=12)
            name = label(title + ":", bold=True)
            value = Gtk.Label(label="—")
            value.set_xalign(0)
            value.set_line_wrap(True)
            line.pack_start(name, False, False, 0)
            line.pack_start(value, True, True, 0)
            card.pack_start(line, False, False, 0)
            self.review_labels[key] = value
        page.pack_start(card, True, True, 0)
        warning = label(
            "IMPORTANTE: al pulsar «Instalar NEXORA» se borrarán las particiones "
            "y los archivos del disco indicado. No se puede deshacer.", bold=True
        )
        page.pack_start(warning, False, False, 0)
        self.stack.add_named(page, "review")

    def update_review(self):
        locale_names = {
            "es_CL.UTF-8": "Español (Chile)",
            "es_ES.UTF-8": "Español (España)",
            "en_US.UTF-8": "English (United States)",
            "en_GB.UTF-8": "English (United Kingdom)",
            "pt_BR.UTF-8": "Português (Brasil)",
        }
        keyboard_names = {
            "latam": "Latinoamericano", "us": "English (US)",
            "es": "Español", "br": "Português (Brasil)",
        }
        values = {
            "disk": self.disk_combo.get_active_id() or "Sin seleccionar",
            "hostname": self.host.get_text().strip(),
            "username": self.user.get_text().strip().lower(),
            "root": ("Activada (contraseña independiente)" if self.root_enabled.get_active()
                     else "Desactivada; administración mediante sudo"),
            "locale": locale_names.get(self.locale_combo.get_active_id(), "No seleccionado"),
            "keyboard": keyboard_names.get(self.keyboard_combo.get_active_id(), "No seleccionado"),
            "timezone": self.timezone_combo.get_active_id() or "No seleccionada",
            "desktop": {
                "xfce": "NEXORA XFCE4",
                "minimal": "NEXORA Minimal (sistema base)",
            }.get(self.desktop_profile, "Edición no reconocida"),
            "network": self.network_status.get_text(),
            "apt": self.apt_mirror.get_text().strip(),
        }
        for key, value in values.items():
            self.review_labels[key].set_text(value)

    def build_progress(self):
        page = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=18)
        page.set_border_width(28)
        page.pack_start(label("Instalando NEXORA OS", "x-large"), False, False, 0)
        self.progress_label = label("Preparando el instalador…")
        page.pack_start(self.progress_label, False, False, 0)
        self.progress = Gtk.ProgressBar()
        self.progress.set_show_text(True)
        self.progress.set_text("En espera")
        page.pack_start(self.progress, False, False, 0)
        self.log = Gtk.TextView()
        self.log.set_editable(False)
        self.log.set_cursor_visible(False)
        self.log.set_wrap_mode(Gtk.WrapMode.WORD_CHAR)
        scroller = Gtk.ScrolledWindow()
        scroller.set_min_content_height(220)
        scroller.add(self.log)
        page.pack_start(scroller, True, True, 0)
        self.stack.add_named(page, "progress")

    def show_page(self, page):
        self.page = page
        self.stack.set_visible_child_name(["welcome", "storage", "config", "review", "progress"][page])
        self.back.set_sensitive(page > 0 and not self.install_started)
        self.next.set_label("Instalar NEXORA" if page == 3 else "Continuar")
        self.next.set_sensitive(not self.install_started)
        if page == 4:
            self.next.set_label("Cerrar")
            self.next.set_sensitive(self.process is None)

    def go_back(self, _button):
        if self.page > 0 and not self.install_started:
            self.show_page(self.page - 1)

    def go_next(self, _button):
        if self.page == 0:
            self.refresh_storage()
            if not self.disks:
                self.show_error("No se detectaron discos de 12 GB o más que estén libres.")
                return
            self.show_page(1)
            return
        if self.page == 1:
            if not self.selected_storage_disk:
                self.show_error("Selecciona un disco completo disponible en la lista. Las particiones se muestran solo como información.")
                return
            self.disk_combo.set_active_id(self.selected_storage_disk)
            self.show_page(2)
            return
        if self.page == 2:
            self.update_review()
            self.show_page(3)
            return
        if self.page == 3:
            self.start_install()
            return
        if self.process is None:
            Gtk.main_quit()

    def start_install(self):
        disk = self.disk_combo.get_active_id()
        username = self.user.get_text().strip().lower()
        hostname = self.host.get_text().strip().lower()
        password = self.password.get_text()
        locale_code = self.locale_combo.get_active_id()
        keyboard_layout = self.keyboard_combo.get_active_id()
        timezone = self.timezone_combo.get_active_id()
        root_enabled = self.root_enabled.get_active()
        root_password = self.root_password.get_text()
        if not disk:
            self.show_error("Selecciona un disco de destino.")
            return
        if not re.fullmatch(r"[a-z_][a-z0-9_-]{0,31}", username):
            self.show_error("El usuario debe usar letras minúsculas, números, guion o guion bajo.")
            return
        if not re.fullmatch(r"[a-z0-9][a-z0-9-]{0,62}", hostname):
            self.show_error("El nombre del equipo no es válido.")
            return
        if len(password) < 8 or password != self.password2.get_text():
            self.show_error("Las contraseñas deben coincidir y tener al menos 8 caracteres.")
            return
        if not all((locale_code, keyboard_layout, timezone)):
            self.show_error("Selecciona idioma, teclado y zona horaria.")
            return
        apt_mirror = self.apt_mirror.get_text().strip().rstrip("/")
        if not re.fullmatch(r"https://[A-Za-z0-9.-]+(?::[0-9]{1,5})?(?:/[A-Za-z0-9._~:/-]*)?", apt_mirror):
            self.show_error("El repositorio APT debe ser una URL HTTPS válida.")
            return
        desktop = self.desktop_profile
        if desktop not in {"xfce", "minimal"}:
            self.show_error("No se pudo detectar la edición de NEXORA de esta ISO. No se iniciará la instalación.")
            return
        if root_enabled and (len(root_password) < 12 or root_password != self.root_password2.get_text()):
            self.show_error("La contraseña de root debe coincidir y tener al menos 12 caracteres.")
            return
        confirm = Gtk.MessageDialog(
            transient_for=self, flags=Gtk.DialogFlags.MODAL,
            message_type=Gtk.MessageType.WARNING, buttons=Gtk.ButtonsType.CANCEL,
            text="¿Borrar e instalar NEXORA en este disco?"
        )
        confirm.format_secondary_text(
            f"Destino: {disk}\n\nSe eliminarán todas las particiones y archivos de ese disco. "
            "Esta acción no se puede deshacer. Para habilitar la instalación, escribe exactamente "
            "la ruta del disco de destino que aparece abajo."
        )
        area = confirm.get_message_area()
        path_label = Gtk.Label(label=f"Escribe: {disk}")
        path_label.set_xalign(0)
        area.pack_start(path_label, False, False, 6)
        typed_path = Gtk.Entry()
        typed_path.set_placeholder_text(disk)
        typed_path.set_activates_default(True)
        area.pack_start(typed_path, False, False, 4)
        confirm.add_button("Borrar disco e instalar", Gtk.ResponseType.ACCEPT)
        confirm.set_default_response(Gtk.ResponseType.CANCEL)
        confirm.show_all()
        response = confirm.run()
        confirmed_path = typed_path.get_text().strip()
        confirm.destroy()
        if response != Gtk.ResponseType.ACCEPT or confirmed_path != disk:
            return

        fd, self.secret_path = tempfile.mkstemp(prefix="nexora-install-secret-")
        os.fchmod(fd, 0o600)
        with os.fdopen(fd, "w", encoding="utf-8") as secret:
            secret.write(password)
        self.password.set_text("")
        self.password2.set_text("")
        root_secret_path = "-"
        if root_enabled:
            fd, root_secret_path = tempfile.mkstemp(prefix="nexora-root-secret-")
            os.fchmod(fd, 0o600)
            with os.fdopen(fd, "w", encoding="utf-8") as secret:
                secret.write(root_password)
        self.root_password.set_text("")
        self.root_password2.set_text("")
        self.install_started = True
        self.show_page(4)
        self.status.set_text("Instalación en curso…")
        self.next.set_label("Instalando…")
        self.next.set_sensitive(False)
        command = ["pkexec", ENGINE, disk, username, hostname,
                   locale_code, timezone, keyboard_layout,
                   "yes" if root_enabled else "no", root_secret_path, self.secret_path,
                   desktop, apt_mirror]
        try:
            self.process = subprocess.Popen(command, stdout=subprocess.PIPE, stderr=subprocess.STDOUT,
                                           text=False, bufsize=0)
            os.set_blocking(self.process.stdout.fileno(), False)
            GLib.timeout_add(250, self.poll_process)
        except Exception as error:
            self.process = None
            self.install_started = False
            for secret_file in (self.secret_path, root_secret_path):
                if secret_file != "-":
                    try: Path(secret_file).unlink()
                    except OSError: pass
            self.secret_path = None
            self.show_error(str(error))

    def poll_process(self):
        if not self.process:
            return False
        try:
            data = os.read(self.process.stdout.fileno(), 4096).decode("utf-8", "replace")
            if data:
                buffer = self.log.get_buffer()
                buffer.insert(buffer.get_end_iter(), data)
                mark = buffer.create_mark(None, buffer.get_end_iter(), False)
                self.log.scroll_to_mark(mark, 0.0, True, 0.0, 1.0)
                self.progress.pulse()
                self.progress.set_text("Trabajando…")
                self.progress_label.set_text("Instalando el sistema y configurando el arranque.")
        except BlockingIOError:
            pass
        code = self.process.poll()
        if code is None:
            return True
        # Leer cualquier salida que haya quedado en el pipe.
        try:
            tail = self.process.stdout.read().decode("utf-8", "replace")
            if tail:
                self.log.get_buffer().insert(self.log.get_buffer().get_end_iter(), tail)
        except Exception:
            pass
        self.process = None
        self.next.set_sensitive(True)
        self.next.set_label("Cerrar")
        self.back.set_sensitive(False)
        if code == 0:
            self.progress.set_fraction(1.0)
            self.progress.set_text("Instalación completada")
            self.progress_label.set_text("¡NEXORA OS está instalado! Reinicia y retira el USB.")
            self.status.set_text("Instalación finalizada")
        else:
            self.progress.set_text("La instalación no terminó")
            self.progress_label.set_text("Revisa el registro y vuelve a intentarlo.")
            self.status.set_text("Error durante la instalación")
        return False

    def show_error(self, message):
        dialog = Gtk.MessageDialog(transient_for=self, flags=Gtk.DialogFlags.MODAL,
                                   message_type=Gtk.MessageType.ERROR,
                                   buttons=Gtk.ButtonsType.CLOSE, text="No se puede continuar")
        dialog.format_secondary_text(message)
        dialog.run()
        dialog.destroy()

    def on_close(self, *_args):
        if self.process is not None:
            dialog = Gtk.MessageDialog(transient_for=self, flags=Gtk.DialogFlags.MODAL,
                                      message_type=Gtk.MessageType.WARNING,
                                      buttons=Gtk.ButtonsType.CANCEL,
                                      text="La instalación está en curso")
            dialog.format_secondary_text("No cierres el instalador mientras se modifica el disco.")
            dialog.run()
            dialog.destroy()
            return True
        if self.secret_path:
            try: Path(self.secret_path).unlink()
            except OSError: pass
        return False

if __name__ == "__main__":
    app = NexoraInstaller()
    app.show_all()
    Gtk.main()
