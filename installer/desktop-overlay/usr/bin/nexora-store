#!/usr/bin/python3
"""NEXORA Store — curated GTK3 catalog for Flatpak applications."""

import json
import re
import subprocess
import threading
from pathlib import Path

import gi
gi.require_version("Gtk", "3.0")
from gi.repository import Gtk, GLib, Pango


CATALOG_PATH = Path("/usr/share/nexora/catalog.json")
APP_ID_PATTERN = re.compile(r"^[A-Za-z0-9_.]+$")


class NexoraStore(Gtk.Window):
    def __init__(self):
        super().__init__(title="NEXORA Store")
        self.set_default_size(820, 620)
        self.set_border_width(12)
        self.apps = []
        self.rows = []

        header = Gtk.HeaderBar()
        header.set_show_close_button(True)
        header.props.title = "NEXORA Store"
        self.set_titlebar(header)

        update_button = Gtk.Button(label="Update all")
        update_button.connect("clicked", self.update_all)
        header.pack_end(update_button)

        root = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=10)
        self.add(root)

        intro = Gtk.Label()
        intro.set_markup("<span size='large' weight='bold'>Discover apps. Keep your system light.</span>")
        intro.set_xalign(0)
        root.pack_start(intro, False, False, 0)

        filters = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=8)
        self.search = Gtk.SearchEntry()
        self.search.set_placeholder_text("Search NEXORA's curated catalog…")
        self.search.set_hexpand(True)
        self.search.connect("search-changed", self.filter_apps)
        filters.pack_start(self.search, True, True, 0)

        self.category = Gtk.ComboBoxText()
        self.category.append_text("All categories")
        for name in ("Productivity", "Graphics", "Development", "Multimedia", "Games", "System"):
            self.category.append_text(name)
        self.category.set_active(0)
        self.category.connect("changed", self.filter_apps)
        filters.pack_end(self.category, False, False, 0)
        root.pack_start(filters, False, False, 0)

        self.status = Gtk.Label(label="Loading NEXORA catalog…")
        self.status.set_xalign(0)
        root.pack_start(self.status, False, False, 0)

        scroll = Gtk.ScrolledWindow()
        scroll.set_policy(Gtk.PolicyType.NEVER, Gtk.PolicyType.AUTOMATIC)
        scroll.set_hexpand(True)
        scroll.set_vexpand(True)
        root.pack_start(scroll, True, True, 0)

        self.listbox = Gtk.ListBox()
        self.listbox.set_selection_mode(Gtk.SelectionMode.NONE)
        scroll.add(self.listbox)

        self.show_all()
        self.load_catalog()

    def run_worker(self, command, callback, timeout=300):
        def worker():
            try:
                result = subprocess.run(
                    command, text=True, stdout=subprocess.PIPE,
                    stderr=subprocess.STDOUT, timeout=timeout, check=False
                )
                GLib.idle_add(callback, result.returncode, result.stdout)
            except Exception as error:
                GLib.idle_add(callback, 1, str(error))
        threading.Thread(target=worker, daemon=True).start()

    def load_catalog(self):
        self.status.set_text("Loading NEXORA's curated catalog…")
        try:
            raw = json.loads(CATALOG_PATH.read_text(encoding="utf-8"))
            self.apps = []
            for item in raw.get("applications", []):
                app_id = str(item.get("id", "")).strip()
                name = str(item.get("name", "")).strip()
                category = str(item.get("category", "Other")).strip()
                if APP_ID_PATTERN.fullmatch(app_id) and name:
                    self.apps.append({
                        "id": app_id,
                        "name": name,
                        "description": str(item.get("description", "")).strip(),
                        "category": category,
                    })
        except Exception as error:
            self.status.set_text("Could not read the NEXORA catalog.")
            self.show_error(str(error))
            return

        self.run_worker(
            ["flatpak", "remotes", "--columns=name"],
            self.remote_loaded
        )

    def remote_loaded(self, code, output):
        remotes = {line.strip() for line in output.splitlines() if line.strip()}
        if code != 0 or "flathub" not in remotes:
            self.status.set_text("Flathub is not configured.")
            self.show_error("The Flathub remote is missing. Check the system's Flatpak configuration.")
            return False
        self.run_worker(
            ["flatpak", "list", "--app", "--columns=application"],
            self.installed_loaded
        )
        return False

    def installed_loaded(self, code, output):
        installed = set()
        if code == 0:
            installed = {line.strip() for line in output.splitlines() if line.strip()}
        self.populate(installed)
        self.status.set_text(f"{len(self.apps)} curated applications available")
        return False

    def populate(self, installed):
        for row in self.listbox.get_children():
            self.listbox.remove(row)
        self.rows = []

        for app in self.apps:
            row = Gtk.ListBoxRow()
            row.app_id = app["id"]
            row.category_name = app["category"]
            row.search_text = f'{app["name"]} {app["id"]} {app["description"]} {app["category"]}'.casefold()

            outer = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=12)
            outer.set_border_width(10)
            details = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=3)
            details.set_hexpand(True)

            title = Gtk.Label(label=app["name"])
            title.set_xalign(0)
            title.set_ellipsize(Pango.EllipsizeMode.END)
            title.get_style_context().add_class("heading")
            details.pack_start(title, False, False, 0)

            subtitle = Gtk.Label(label=f'{app["category"]} · {app["id"]}')
            subtitle.set_xalign(0)
            subtitle.set_selectable(True)
            details.pack_start(subtitle, False, False, 0)

            if app["description"]:
                summary = Gtk.Label(label=app["description"])
                summary.set_xalign(0)
                summary.set_line_wrap(True)
                summary.set_max_width_chars(88)
                details.pack_start(summary, False, False, 0)

            app_id = app["id"]
            action = Gtk.Button(label="Remove" if app_id in installed else "Install")
            action.app_id = app_id
            action.action_name = "remove" if app_id in installed else "install"
            action.connect("clicked", self.app_action)
            outer.pack_start(details, True, True, 0)
            outer.pack_end(action, False, False, 0)
            row.add(outer)
            self.listbox.add(row)
            self.rows.append(row)

        self.listbox.show_all()
        self.filter_apps()

    def filter_apps(self, *_args):
        query = self.search.get_text().strip().casefold()
        selected = self.category.get_active_text()
        for row in self.rows:
            category_matches = selected == "All categories" or row.category_name == selected
            query_matches = not query or query in row.search_text
            row.set_visible(category_matches and query_matches)
        return False

    def app_action(self, button):
        app_id = button.app_id
        if button.action_name == "install":
            command = ["pkexec", "flatpak", "install", "--system", "-y", "flathub", app_id]
            verb = "Installing"
        else:
            command = ["pkexec", "flatpak", "uninstall", "--system", "-y", app_id]
            verb = "Removing"

        button.set_sensitive(False)
        self.status.set_text(f"{verb} {app_id}…")
        self.run_worker(command, self.action_finished, timeout=900)

    def action_finished(self, code, output):
        if code == 0:
            self.status.set_text("Operation completed. Refreshing the catalog…")
            self.load_catalog()
        else:
            self.status.set_text("The operation did not complete.")
            self.show_error(output)
            self.load_catalog()
        return False

    def update_all(self, _button):
        self.status.set_text("Checking for Flatpak updates…")
        self.run_worker(
            ["pkexec", "flatpak", "update", "--system", "-y"],
            self.action_finished, timeout=1200
        )

    def show_error(self, message):
        dialog = Gtk.MessageDialog(
            transient_for=self, flags=0, message_type=Gtk.MessageType.ERROR,
            buttons=Gtk.ButtonsType.CLOSE, text="NEXORA Store"
        )
        dialog.format_secondary_text(message[-2500:] if message else "Unknown error")
        dialog.run()
        dialog.destroy()


def main():
    window = NexoraStore()
    window.connect("destroy", Gtk.main_quit)
    Gtk.main()


if __name__ == "__main__":
    main()
