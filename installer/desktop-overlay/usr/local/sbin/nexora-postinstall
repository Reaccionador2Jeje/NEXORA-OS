#!/bin/sh
set -eu
# Apply NEXORA identity and XFCE defaults without replacing Debian packages or licenses.
mkdir -p /etc/skel/.config/xfce4/xfconf/xfce-perchannel-xml
mkdir -p /usr/share/backgrounds/nexora /usr/share/themes
cat > /etc/nexora-release <<'RELEASE'
NEXORA OS 0.2.0
Based on Debian GNU/Linux 13 (Trixie)
Desktop: XFCE
Your Terminal. Your Universe.
RELEASE
cat > /etc/issue <<'ISSUE'
\n
NEXORA OS 0.2.0 — Debian GNU/Linux 13 (Trixie)
Your Terminal. Your Universe.
\n
ISSUE
cat > /etc/motd <<'MOTD'

  NEXORA OS 0.2.0
  Based on Debian GNU/Linux 13 (Trixie)
  Your Terminal. Your Universe.

MOTD
mkdir -p /etc/profile.d
cat > /etc/profile.d/nexora.sh <<'PROFILE'
# NEXORA identity for interactive POSIX-compatible shells.
if [ -n "${PS1-}" ] && [ -z "${NEXORA_PROMPT_SHOWN-}" ]; then
    NEXORA_PROMPT_SHOWN=1
    export NEXORA_PROMPT_SHOWN
    printf '\n  NEXORA OS 0.2.0 | Debian 13 Trixie\n  Your Terminal. Your Universe.\n\n'
fi
PROFILE
chmod 0644 /etc/profile.d/nexora.sh /etc/nexora-release /etc/issue /etc/motd

if command -v flatpak >/dev/null 2>&1; then
    flatpak remote-add --system --if-not-exists flathub https://flathub.org/repo/flathub.flatpakrepo || true
fi

if [ -f /usr/share/backgrounds/nexora/nexora-default.svg ]; then
    cat > /etc/skel/.config/xfce4/xfconf/xfce-perchannel-xml/xfce4-desktop.xml <<'XML'
<?xml version="1.0" encoding="UTF-8"?>
<channel name="xfce4-desktop" version="1.0">
 <property name="backdrop" type="empty"><property name="screen0" type="empty"><property name="monitor0" type="empty"><property name="workspace0" type="empty">
  <property name="last-image" type="string" value="/usr/share/backgrounds/nexora/nexora-default.svg"/>
  <property name="image-style" type="int" value="5"/>
 </property></property></property></property>
</channel>
XML
fi
cat > /etc/skel/.config/xfce4/xfconf/xfce-perchannel-xml/xsettings.xml <<'XML'
<?xml version="1.0" encoding="UTF-8"?>
<channel name="xsettings" version="1.0">
 <property name="Net" type="empty"><property name="ThemeName" type="string" value="NEXORA-Ocean"/><property name="IconThemeName" type="string" value="Adwaita"/></property>
 <property name="Xft" type="empty"><property name="DPI" type="int" value="96"/><property name="Antialias" type="int" value="1"/><property name="Hinting" type="int" value="1"/></property>
</channel>
XML

# Make NEXORA XFCE defaults available system-wide as well as through /etc/skel.
SYSTEM_XFCE="/etc/xdg/xfce4/xfconf/xfce-perchannel-xml"
mkdir -p "$SYSTEM_XFCE"
cp -f /etc/skel/.config/xfce4/xfconf/xfce-perchannel-xml/*.xml "$SYSTEM_XFCE/"

# Apply the defaults to accounts created before the installer hook ran.
for home in /home/*; do
    [ -d "$home" ] || continue
    user=$(basename "$home")
    mkdir -p "$home/.config/xfce4/xfconf/xfce-perchannel-xml"
    cp -f /etc/skel/.config/xfce4/xfconf/xfce-perchannel-xml/*.xml "$home/.config/xfce4/xfconf/xfce-perchannel-xml/"
    chown -R "$user":"$(id -gn "$user" 2>/dev/null || echo "$user")" "$home/.config" 2>/dev/null || true
done

chmod 0755 /usr/bin/nexora-ai /usr/bin/nexora-center /usr/bin/nexora-store /usr/bin/nexora-welcome /usr/bin/nexora-updater 2>/dev/null || true
chmod 0755 /usr/local/sbin/nexora-postinstall
if command -v update-desktop-database >/dev/null 2>&1; then
    update-desktop-database /usr/share/applications >/dev/null 2>&1 || true
fi
exit 0
