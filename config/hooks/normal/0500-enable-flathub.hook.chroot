#!/bin/sh
# Enable Flathub as a system-wide Flatpak remote. No Flatpak apps are installed.
set -eu

if ! command -v flatpak >/dev/null 2>&1; then
    echo "Flatpak is not installed; cannot configure Flathub." >&2
    exit 1
fi

flatpak remote-add --system --if-not-exists flathub https://dl.flathub.org/repo/flathub.flatpakrepo
