# NEXORA OS Minimal 0.1.0 — terminal-only package manifest.
# No graphical stack, browser, Flatpak, firmware bundle or games.

# Debian Live runtime and systemd init.
live-boot
live-config
live-config-systemd
live-tools
systemd-sysv
user-setup

# Kernel installed through APT; live-build kernel discovery is disabled.
linux-image-amd64

# Shell and essential GNU / system utilities.
bash
coreutils
util-linux
findutils
grep
sed
gawk
diffutils
procps
psmisc
iproute2
iputils-ping
hostname
login
passwd
sudo
locales
keyboard-configuration
console-setup

# Basic wired networking (DHCP) and package management.
ifupdown
isc-dhcp-client

# Package management, certificates and basic network access.
apt
ca-certificates
curl
wget
less
nano
