# NEXORA OS 0.2.0 — Hyper Lightweight XFCE4 desktop
# Keep this manifest intentionally small. Do not add games or heavyweight desktop suites.

# X.Org display server and XFCE desktop
xserver-xorg
xfce4-session
xfce4-panel
xfdesktop4
xfwm4
xfconf
xfce4-settings
xfce4-appfinder
xfce4-terminal
xfce4-whiskermenu-plugin

# File manager and basic desktop integration
thunar
thunar-volman
gvfs
gvfs-backends
dbus-x11
lightdm
lightdm-gtk-greeter

# Network and removable-device support
network-manager
network-manager-gnome
udisks2
upower
polkitd

# Audio without a heavyweight desktop stack
pipewire-audio
wireplumber
xfce4-pulseaudio-plugin

# Flatpak support — applications and games are user-installed, never bundled
flatpak
xdg-desktop-portal
xdg-desktop-portal-gtk

# Essential system utilities
sudo
locales
keyboard-configuration
xdg-utils
xdg-user-dirs
ca-certificates
curl
wget
nano
htop
fastfetch
bash-completion
