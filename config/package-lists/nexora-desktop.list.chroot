# NEXORA OS 0.2.0 — Hyper Lightweight XFCE4 desktop
# Keep this manifest intentionally small. No games or heavyweight desktop suites.

# Kernel is installed as a normal APT package; live-build kernel discovery is disabled.

# Match the selected systemd init system in Debian Live.
live-config-systemd
linux-image-amd64

# X.Org display server and XFCE desktop
xserver-xorg
xfce4-session
xfce4-panel
xfdesktop4
xfwm4
xfconf
xfce4-settings
xfce4-appfinder
xfce4-terminal
xfce4-whiskermenu-plugin

# File manager and desktop integration
thunar
thunar-volman
gvfs
dbus-x11
lightdm
lightdm-gtk-greeter
adwaita-icon-theme

# Network, removable devices and authorization prompts
network-manager
network-manager-gnome
udisks2
upower
polkitd
pkexec
lxpolkit

# Audio
pipewire-audio
pipewire-pulse
wireplumber
xfce4-pulseaudio-plugin

# Flatpak and the lightweight NEXORA Store (GTK3 + Python bindings)
flatpak
python3-gi
gir1.2-gtk-3.0
xdg-desktop-portal
xdg-desktop-portal-gtk

# Web browser
chromium

# Essential system utilities
sudo
locales
keyboard-configuration
xdg-utils
xdg-user-dirs
ca-certificates
curl
wget
nano
htop
fastfetch
bash-completion
