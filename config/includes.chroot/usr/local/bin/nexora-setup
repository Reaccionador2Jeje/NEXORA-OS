#!/bin/bash
# NEXORA Setup — lightweight, dependency-free terminal menu.
set -Eeuo pipefail

VERSION="0.1.0"
LIB="/usr/share/nexora"
DESKTOP_PACKAGES="$LIB/desktop-packages.list"

if [[ $EUID -ne 0 ]]; then
  echo "NEXORA Setup necesita permisos de administrador."
  echo "Ejecuta: sudo nexora-setup"
  exit 1
fi
if [[ ! -t 0 || ! -t 1 ]]; then
  echo "NEXORA Setup requiere una terminal interactiva."
  exit 1
fi

cyan=$'\033[1;36m'
green=$'\033[1;32m'
yellow=$'\033[1;33m'
reset=$'\033[0m'

pause() { echo; read -r -p "Presiona ENTER para continuar..." _; }
header() {
  clear
  printf '%s' "$cyan"
  cat <<'BANNER'
 _   _ _____  _____  ___  ____   _
| \ | | ____|/ ___/ / _ \|  _ \ / \ 
|  \| |  _|  \___ \| | | | |_) / _ \
| |\  | |___  ___) | |_| |  _ </ ___ \
|_| \_|_____|/____/ \___/|_| \_/_/   \
BANNER
  printf '%sNEXORA SETUP %s — Terminal Edition%s\n' "$green" "$VERSION" "$reset"
  echo "Tu sistema. Tu elección."
  echo "------------------------------------------------------------"
}

install_desktop() {
  if dpkg -s xfce4-session 2>/dev/null | grep -q '^Status: install ok installed$'; then
    echo "El escritorio NEXORA ya parece estar instalado."
    pause
    return
  fi
  if [[ ! -s "$DESKTOP_PACKAGES" ]]; then
    echo "No se encuentra el manifiesto: $DESKTOP_PACKAGES"
    pause
    return
  fi
  echo "Se instalará el escritorio XFCE de NEXORA."
  echo "La ISO base no incluye estos paquetes; solo se descargarán ahora."
  read -r -p "¿Continuar? [s/N]: " answer
  [[ "$answer" =~ ^[sS]$ ]] || return
  mapfile -t packages < <(grep -Ev '^[[:space:]]*(#|$)' "$DESKTOP_PACKAGES")
  if ! apt-get update; then
    echo "No se pudieron actualizar los índices APT."
    pause
    return
  fi
  if ! DEBIAN_FRONTEND=noninteractive apt-get install -y --no-install-recommends "${packages[@]}"; then
    echo "La instalación del escritorio no terminó. Revisa el error de APT."
    pause
    return
  fi
  flatpak remote-add --system --if-not-exists flathub https://dl.flathub.org/repo/flathub.flatpakrepo || echo "Aviso: no se pudo configurar Flathub; puedes reintentarlo luego."
  systemctl enable NetworkManager
  systemctl enable lightdm
  systemctl set-default graphical.target
  echo
  echo "${green}Escritorio NEXORA instalado.${reset}"
  echo "Reinicia el equipo para iniciar en modo gráfico."
  pause
}

remove_desktop() {
  if ! dpkg -s xfce4-session 2>/dev/null | grep -q '^Status: install ok installed$'; then
    echo "No se detecta XFCE instalado."
    pause
    return
  fi
  echo "Esto eliminará los paquetes del perfil de escritorio NEXORA."
  read -r -p "¿Volver al perfil terminal? [s/N]: " answer
  [[ "$answer" =~ ^[sS]$ ]] || return
  systemctl disable --now lightdm 2>/dev/null || true
  systemctl set-default multi-user.target
  mapfile -t packages < <(grep -Ev '^[[:space:]]*(#|$)' "$DESKTOP_PACKAGES")
  apt-get purge -y "${packages[@]}" || true
  apt-get autoremove --purge -y
  echo
  echo "${green}Se ha solicitado volver al perfil terminal.${reset}"
  echo "Reinicia el equipo. Revisa los paquetes restantes antes de liberar espacio."
  pause
}

while true; do
  header
  echo "  1) Información del sistema"
  echo "  2) Actualizar sistema"
  echo "  3) Instalar escritorio NEXORA (opcional)"
  echo "  4) Desinstalar escritorio NEXORA"
  echo "  5) Salir"
  echo
  read -r -p "Selecciona una opción [1-5]: " choice
  case "$choice" in
    1) header; cat /etc/nexora-release 2>/dev/null || cat /etc/os-release; echo; df -h /; pause ;;
    2) apt-get update && apt-get upgrade; pause ;;
    3) install_desktop ;;
    4) remove_desktop ;;
    5) clear; exit 0 ;;
    *) printf '%sOpción no válida.%s\n' "$yellow" "$reset"; sleep 1 ;;
  esac
done
