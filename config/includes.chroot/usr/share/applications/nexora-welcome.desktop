[Desktop Entry]
Type=Application
Name=NEXORA Welcome
GenericName=Welcome to NEXORA OS
Comment=Get started with your NEXORA XFCE desktop
Exec=xfce4-terminal --title=NEXORA-Welcome --command=/usr/bin/nexora-welcome
Icon=/usr/share/pixmaps/nexora-icon.svg
Terminal=false
Categories=System;Utility;
StartupNotify=true
