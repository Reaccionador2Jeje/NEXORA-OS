#!/usr/bin/python3
"""NEXORA Store — card-based Flatpak catalog."""
import json, re, subprocess, threading
from pathlib import Path
import gi
gi.require_version("Gtk", "3.0")
from gi.repository import Gtk, GLib, Pango

CATALOG = Path("/usr/share/nexora-store/catalog.json")
CSS = Path("/usr/share/nexora-store/store.css")
ID_RE = re.compile(r"^[A-Za-z][A-Za-z0-9_-]*(?:\\.[A-Za-z][A-Za-z0-9_-]*){2,}$")

class Store(Gtk.Window):
    def __init__(self):
        super().__init__(title="NEXORA Store")
        self.set_default_size(1060, 720)
        self.set_position(Gtk.WindowPosition.CENTER)
        self.get_style_context().add_class("nexora-store")
        self.apps, self.installed, self.cards = [], set(), []
        self.load_style()
        header = Gtk.HeaderBar(title="NEXORA Store")
        header.set_show_close_button(True)
        refresh = Gtk.Button.new_from_icon_name("view-refresh-symbolic", Gtk.IconSize.BUTTON)
        refresh.set_tooltip_text("Actualizar catálogo y aplicaciones")
        refresh.connect("clicked", lambda *_: self.refresh())
        header.pack_end(refresh)
        self.set_titlebar(header)

        root = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=14)
        root.set_border_width(18)
        self.add(root)
        hero = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=6)
        hero.get_style_context().add_class("nexora-hero")
        title = Gtk.Label(label="Descubre tu próximo favorito")
        title.set_xalign(0); title.get_style_context().add_class("nexora-title")
        subtitle = Gtk.Label(label="Aplicaciones seleccionadas para crear, trabajar y jugar.")
        subtitle.set_xalign(0); subtitle.get_style_context().add_class("nexora-muted")
        hero.pack_start(title, False, False, 0); hero.pack_start(subtitle, False, False, 0)
        root.pack_start(hero, False, False, 0)

        controls = Gtk.Box(spacing=10)
        self.search = Gtk.SearchEntry()
        self.search.set_placeholder_text("Buscar aplicaciones…")
        self.search.set_hexpand(True); self.search.connect("search-changed", self.filter)
        controls.pack_start(self.search, True, True, 0)
        self.category = Gtk.ComboBoxText()
        self.category.append("all", "Todas las categorías")
        for cat in ["Productivity","Graphics","Development","Multimedia","Games","Internet","Education","System"]:
            self.category.append(cat, {"Productivity":"Productividad","Graphics":"Gráficos","Development":"Desarrollo","Multimedia":"Multimedia","Games":"Juegos","Internet":"Internet","Education":"Educación","System":"Sistema"}[cat])
        self.category.set_active_id("all"); self.category.connect("changed", self.filter)
        controls.pack_end(self.category, False, False, 0)
        root.pack_start(controls, False, False, 0)

        self.status = Gtk.Label(label="Preparando NEXORA Store…")
        self.status.set_xalign(0); self.status.get_style_context().add_class("nexora-muted")
        root.pack_start(self.status, False, False, 0)
        scroll = Gtk.ScrolledWindow(); scroll.set_policy(Gtk.PolicyType.NEVER, Gtk.PolicyType.AUTOMATIC)
        scroll.set_vexpand(True); root.pack_start(scroll, True, True, 0)
        self.flow = Gtk.FlowBox()
        self.flow.set_selection_mode(Gtk.SelectionMode.NONE)
        self.flow.set_max_children_per_line(4); self.flow.set_min_children_per_line(1)
        self.flow.set_column_spacing(12); self.flow.set_row_spacing(12)
        self.flow.set_homogeneous(True); scroll.add(self.flow)
        self.load_catalog()
        self.show_all()

    def load_style(self):
        try:
            provider=Gtk.CssProvider(); provider.load_from_path(str(CSS))
            Gtk.StyleContext.add_provider_for_screen(Gdk.Screen.get_default(), provider, Gtk.STYLE_PROVIDER_PRIORITY_APPLICATION)
        except Exception:
            pass

    def load_catalog(self):
        try:
            raw=json.loads(CATALOG.read_text(encoding="utf-8"))
            self.apps=[a for a in raw["applications"] if ID_RE.fullmatch(a.get("id","")) and a.get("name")]
        except Exception as e:
            self.status.set_text("No se pudo cargar el catálogo: "+str(e)); return
        self.run(["flatpak","remotes","--columns=name"], self.remotes_done)

    def run(self, command, callback, timeout=900):
        def worker():
            try:
                p=subprocess.run(command,text=True,stdout=subprocess.PIPE,stderr=subprocess.STDOUT,timeout=timeout)
                GLib.idle_add(callback,p.returncode,p.stdout)
            except Exception as e: GLib.idle_add(callback,1,str(e))
        threading.Thread(target=worker,daemon=True).start()

    def remotes_done(self, code, out):
        if code or "flathub" not in out.split():
            self.status.set_text("Flathub no está configurado. Ejecuta el asistente NEXORA.")
            return False
        self.run(["flatpak","list","--app","--columns=application"],self.installed_done)
        return False

    def installed_done(self, code, out):
        self.installed=set(out.split()) if code==0 else set()
        self.render()
        self.status.set_text(f"{len(self.apps)} aplicaciones disponibles · {len(self.installed)} instaladas")
        return False

    def render(self):
        for child in self.flow.get_children(): self.flow.remove(child)
        self.cards=[]
        for app in self.apps:
            card=Gtk.Box(orientation=Gtk.Orientation.VERTICAL,spacing=8)
            card.set_size_request(205,190); card.set_border_width(13)
            card.get_style_context().add_class("nexora-card")
            icon=Gtk.Image.new_from_icon_name(app.get("icon","application-x-executable"),Gtk.IconSize.DIALOG)
            icon.set_pixel_size(42); card.pack_start(icon,False,False,0)
            name=Gtk.Label(label=app["name"]); name.set_xalign(0); name.set_ellipsize(Pango.EllipsizeMode.END); name.get_style_context().add_class("nexora-card-title")
            card.pack_start(name,False,False,0)
            desc=Gtk.Label(label=app.get("description","")); desc.set_xalign(0); desc.set_line_wrap(True); desc.set_max_width_chars(28); desc.set_lines(3); desc.get_style_context().add_class("nexora-muted")
            card.pack_start(desc,True,True,0)
            bottom=Gtk.Box(spacing=6)
            tag=Gtk.Label(label=app["category"]); tag.get_style_context().add_class("nexora-pill"); bottom.pack_start(tag,False,False,0)
            btn=Gtk.Button(label="Abrir" if app["id"] in self.installed else "Instalar")
            btn.connect("clicked",self.action,app,btn); bottom.pack_end(btn,False,False,0)
            card.pack_end(bottom,False,False,0)
            self.flow.add(card); card.app=app; self.cards.append(card)
        self.flow.show_all(); self.filter()

    def filter(self,*_):
        q=self.search.get_text().casefold().strip()
        cat=self.category.get_active_id()
        for card in self.cards:
            a=card.app
            show=(cat=="all" or a["category"]==cat) and (not q or q in (a["name"]+" "+a.get("description","")+" "+a["id"]).casefold())
            card.set_visible(show)
        return False

    def action(self,button,app,btn):
        appid=app["id"]
        if appid in self.installed:
            subprocess.Popen(["flatpak","run",appid]); return
        btn.set_sensitive(False); self.status.set_text("Instalando "+app["name"]+"…")
        self.run(["pkexec","flatpak","install","--system","-y","flathub",appid],lambda c,o:self.action_done(c,o,btn),1200)

    def action_done(self,code,out,btn):
        btn.set_sensitive(True)
        if code: self.status.set_text("La instalación no se completó."); self.dialog(out)
        else: self.status.set_text("Instalación completada.")
        self.refresh(); return False

    def refresh(self):
        self.status.set_text("Actualizando aplicaciones…")
        self.run(["pkexec","flatpak","update","--system","-y"],lambda c,o:self.refresh_done(c,o),1200)

    def refresh_done(self,code,out):
        self.status.set_text("Aplicaciones actualizadas." if code==0 else "No se pudieron actualizar las aplicaciones.")
        self.load_catalog(); return False

    def dialog(self,msg):
        d=Gtk.MessageDialog(transient_for=self,flags=0,message_type=Gtk.MessageType.ERROR,buttons=Gtk.ButtonsType.CLOSE,text="NEXORA Store")
        d.format_secondary_text(msg[-2500:]); d.run(); d.destroy()

if __name__=="__main__":
    from gi.repository import Gdk
    Store().show_all()
    Gtk.main()
