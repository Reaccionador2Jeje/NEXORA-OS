{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
  "logo": {
    "type": "file",
    "source": "/usr/share/nexora/fastfetch/nexora.txt",
    "padding": {
      "right": 3
    }
  },
  "display": {
    "separator": "  "
  },
  "modules": [
    "title",
    "separator",
    {
      "type": "command",
      "key": "NEXORA",
      "text": "sed -n '1p' /etc/nexora-release"
    },
    {
      "type": "command",
      "key": "Based on",
      "text": "sed -n 's/^Base: //p' /etc/nexora-release"
    },
    "os",
    "host",
    "kernel",
    "uptime",
    "packages",
    "shell",
    "display",
    "de",
    "wm",
    "theme",
    "terminal",
    "cpu",
    "gpu",
    "memory",
    "break",
    "colors"
  ]
}
